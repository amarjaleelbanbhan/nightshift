{
  "name": "nightshift-cli",
  "version": "0.2.0",
  "description": "An open-source developer terminal customization toolkit. Build your own terminal experience with themes, profiles, widgets, and integrations.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amarjaleelbanbhan/nightshift.git"
  },
  "bugs": {
    "url": "https://github.com/amarjaleelbanbhan/nightshift/issues"
  },
  "homepage": "https://github.com/amarjaleelbanbhan/nightshift#readme",
  "keywords": [
    "cli",
    "terminal",
    "windows-terminal",
    "theme",
    "customization",
    "developer-tools"
  ],
  "bin": {
    "nightshift": "./dist/index.js"
  },
  "files": [
    "dist",
    "profiles",
    "!dist/**/*.map"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src tests",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "prepublishOnly": "npm run clean && npm run format:check && npm run typecheck && npm run lint && npm run build && npm test"
  },
  "dependencies": {
    "@clack/prompts": "^1.9.0",
    "boxen": "^9.0.0",
    "chalk": "^5.4.1",
    "cli-table3": "^0.6.5",
    "commander": "^13.1.0",
    "strip-ansi": "^7.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.72.2",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^9.18.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.8"
    }
  }
}
